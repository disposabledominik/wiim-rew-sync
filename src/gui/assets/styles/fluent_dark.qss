/*
 * Fluent Dark Theme — WiiM ↔ REW PEQ Sync Tool
 *
 * Color values sourced from COLORS_DARK in src/gui/constants.py.
 * Structure mirrors fluent_light.qss exactly — only color values differ.
 *
 * Color reference:
 *   accent: #00B4D8  accent_hover: #33C5E1  accent_pressed: #66D6EA
 *   background: #1E1E1E  surface: #2D2D2D  surface_hover: #3A3A3A
 *   text_primary: #F5F5F5  text_secondary: #B0B0B0  text_disabled: #6E6E6E
 *   border: #404040  border_subtle: #333333
 *   card: #2D2D2D  text_on_accent: #FFFFFF
 *   success: #66BB6A  error: #EF5350  warning: #FFA726
 *
 * Typography: FONT_SIZE_BODY=14, FONT_SIZE_CAPTION=12, FONT_SIZE_HEADING=20
 */

/* ---------------------------------------------------------------------------
   Global Defaults
   --------------------------------------------------------------------------- */

* {
    font-family: "Segoe UI Variable", "Segoe UI", "SF Pro", system-ui, sans-serif;
    font-size: 14px;
    color: #F5F5F5;
    outline: none;
}

/* ---------------------------------------------------------------------------
   QMainWindow
   --------------------------------------------------------------------------- */

QMainWindow {
    background-color: #1E1E1E;
}

/* ---------------------------------------------------------------------------
   QWidget
   --------------------------------------------------------------------------- */

QWidget {
    background-color: #1E1E1E;
    color: #F5F5F5;
}

/* Containers that must be transparent to let parent background show through */
QStackedWidget,
QScrollArea > QWidget > QWidget,
QTabWidget::pane > QWidget {
    background-color: transparent;
}

/* ---------------------------------------------------------------------------
   QFrame
   --------------------------------------------------------------------------- */

QFrame {
    background-color: transparent;
    border: none;
}

QFrame[frameShape="StyledPanel"] {
    background-color: #2D2D2D;
    border: 1px solid #404040;
    border-radius: 8px;
}

QFrame[frameShape="HLine"] {
    background-color: #404040;
    max-height: 1px;
}

QFrame[frameShape="VLine"] {
    background-color: #404040;
    max-width: 1px;
}

/* ---------------------------------------------------------------------------
   QLabel
   --------------------------------------------------------------------------- */

QLabel {
    background-color: transparent;
    color: #F5F5F5;
    padding: 0px;
}

QLabel[class="heading"] {
    font-size: 20px;
    font-weight: 600;
    color: #F5F5F5;
}

QLabel[class="title"] {
    font-size: 26px;
    font-weight: 600;
    color: #F5F5F5;
}

QLabel[class="pageTitle"] {
    font-size: 24px;
    font-weight: 600;
    color: #F5F5F5;
}

QLabel[class="sectionTitle"] {
    font-size: 18px;
    font-weight: 600;
    color: #F5F5F5;
}

QLabel[class="subheading"] {
    font-size: 15px;
    font-weight: 600;
    color: #F5F5F5;
}

QLabel[class="caption"] {
    font-size: 12px;
    color: #B0B0B0;
}

QLabel[class="secondary"] {
    color: #B0B0B0;
}

QLabel[class="disabled"] {
    color: #6E6E6E;
}

QLabel[class="error"] {
    color: #EF5350;
}

QLabel[class="success"] {
    color: #66BB6A;
}

QLabel[class="warning"] {
    color: #FFA726;
}

QLabel[class="info"] {
    color: #00B4D8;
}

QLabel[class="pathError"] {
    font-size: 12px;
    color: #EF5350;
}

QLabel[class="fieldLabel"] {
    font-size: 14px;
    font-weight: 600;
}

QCheckBox[class="accent"] {
    color: #00B4D8;
}

QLabel#dry_run_badge {
    background-color: #FFA726;
    color: #FFFFFF;
    padding: 4px 8px;
    border-radius: 4px;
    font-weight: 600;
}

QFrame[class="warningBox"] {
    border: 1px solid #FFA726;
    border-radius: 8px;
    background-color: rgba(245, 124, 0, 0.08);
    padding: 8px;
}

QLabel[class="badge"] {
    background-color: #00B4D8;
    color: #FFFFFF;
    border-radius: 4px;
    padding: 2px 8px;
}

#ConnectPageSpinner {
    color: #00B4D8;
    font-size: 20px;
    letter-spacing: 8px;
}

QLabel[class="emptyStateIcon"] {
    font-size: 48px;
}

QLabel:disabled {
    color: #6E6E6E;
}

/* ---------------------------------------------------------------------------
   QPushButton
   --------------------------------------------------------------------------- */

QPushButton {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 6px;
    padding: 8px 16px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #3A3A3A;
    border-color: #33C5E1;
}

QPushButton:pressed {
    background-color: #404040;
    border-color: #66D6EA;
}

QPushButton:disabled {
    background-color: #2D2D2D;
    color: #6E6E6E;
    border-color: #333333;
}

QPushButton:focus {
    border: 2px solid #00B4D8;
}

/* Button variants — primary */

QPushButton[class="primary"] {
    background-color: #00B4D8;
    color: #FFFFFF;
    border: 1px solid #00B4D8;
    font-weight: 600;
}

QPushButton[class="primary"]:hover {
    background-color: #33C5E1;
    border-color: #33C5E1;
}

QPushButton[class="primary"]:pressed {
    background-color: #66D6EA;
    border-color: #66D6EA;
}

QPushButton[class="primary"]:disabled {
    background-color: #333333;
    color: #6E6E6E;
    border-color: #333333;
}

/* Button variants — secondary */

QPushButton[class="secondary"] {
    background-color: transparent;
    color: #00B4D8;
    border: 1px solid #00B4D8;
}

QPushButton[class="secondary"]:hover {
    background-color: rgba(0, 180, 216, 0.1);
    border-color: #33C5E1;
    color: #33C5E1;
}

QPushButton[class="secondary"]:pressed {
    background-color: rgba(0, 180, 216, 0.2);
    border-color: #66D6EA;
    color: #66D6EA;
}

QPushButton[class="secondary"]:disabled {
    color: #6E6E6E;
    border-color: #333333;
}

/* Button variants — ghost */

QPushButton[class="ghost"] {
    background-color: transparent;
    color: #F5F5F5;
    border: none;
}

QPushButton[class="ghost"]:hover {
    background-color: #3A3A3A;
}

QPushButton[class="ghost"]:pressed {
    background-color: #404040;
}

QPushButton[class="ghost"]:disabled {
    color: #6E6E6E;
}

/* Button variants — danger */

QPushButton[class="danger"] {
    background-color: #EF5350;
    color: #FFFFFF;
    border: 1px solid #EF5350;
}

QPushButton[class="danger"]:hover {
    background-color: #FF6B68;
    border-color: #FF6B68;
}

QPushButton[class="danger"]:pressed {
    background-color: #D94B48;
    border-color: #D94B48;
}

QPushButton[class="danger"]:disabled {
    background-color: #333333;
    color: #6E6E6E;
    border-color: #333333;
}

/* Button variants — success */

QPushButton[class="success"] {
    background-color: #66BB6A;
    color: #FFFFFF;
    border: 1px solid #66BB6A;
    font-weight: 600;
}

QPushButton[class="success"]:hover {
    background-color: #81C784;
    border-color: #81C784;
}

QPushButton[class="success"]:pressed {
    background-color: #4CAF50;
    border-color: #4CAF50;
}

QPushButton[class="success"]:disabled {
    background-color: #333333;
    color: #6E6E6E;
    border-color: #333333;
}

/* Button variants — warning */

QPushButton[class="warning"] {
    background-color: #FFA726;
    color: #FFFFFF;
    border: 1px solid #FFA726;
    font-weight: 600;
}

QPushButton[class="warning"]:hover {
    background-color: #FFB74D;
    border-color: #FFB74D;
}

QPushButton[class="warning"]:pressed {
    background-color: #FB8C00;
    border-color: #FB8C00;
}

QPushButton[class="warning"]:disabled {
    background-color: #333333;
    color: #6E6E6E;
    border-color: #333333;
}

/* Link-style buttons (flat, underlined accent text) */

QPushButton[class="linkButton"] {
    background-color: transparent;
    color: #00B4D8;
    border: none;
    font-size: 13px;
    text-decoration: underline;
}

QPushButton[class="linkButton"]:hover {
    color: #33C5E1;
}

/* ---------------------------------------------------------------------------
   QLineEdit
   --------------------------------------------------------------------------- */

QLineEdit {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 8px;
    selection-background-color: #00B4D8;
    selection-color: #FFFFFF;
}

QLineEdit:hover {
    border-color: #33C5E1;
}

QLineEdit:focus {
    border: 2px solid #00B4D8;
    padding: 7px;
}

QLineEdit:disabled {
    background-color: #333333;
    color: #6E6E6E;
    border-color: #333333;
}

QLineEdit[readOnly="true"] {
    background-color: #333333;
    border-color: #333333;
}

/* ---------------------------------------------------------------------------
   QSpinBox
   --------------------------------------------------------------------------- */

QSpinBox {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 8px;
    selection-background-color: #00B4D8;
    selection-color: #FFFFFF;
}

QSpinBox:hover {
    border-color: #33C5E1;
}

QSpinBox:focus {
    border: 2px solid #00B4D8;
    padding: 7px;
}

QSpinBox:disabled {
    background-color: #333333;
    color: #6E6E6E;
    border-color: #333333;
}

QSpinBox::up-button,
QSpinBox::down-button {
    subcontrol-origin: border;
    width: 18px;
    border: none;
    background-color: transparent;
}

QSpinBox::up-button {
    subcontrol-position: top right;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
}

QSpinBox::up-button:hover,
QSpinBox::down-button:hover {
    background-color: #3A3A3A;
}

QSpinBox::up-button:pressed,
QSpinBox::down-button:pressed {
    background-color: #404040;
}

QSpinBox::up-arrow,
QSpinBox::down-arrow {
    width: 10px;
    height: 10px;
}

/* ---------------------------------------------------------------------------
   QComboBox
   --------------------------------------------------------------------------- */

QComboBox {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 8px 24px 8px 8px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #33C5E1;
}

QComboBox:focus {
    border: 2px solid #00B4D8;
}

QComboBox:disabled {
    background-color: #333333;
    color: #6E6E6E;
    border-color: #333333;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
}

QComboBox::down-arrow {
    /* Styling ::drop-down opts the combo out of Qt's native arrow -- without
       an explicit image here nothing is painted at all, so there's no
       visual "this is a dropdown" affordance. A border-only triangle (no
       image, matching this theme's otherwise asset-free convention) was
       tried first but Qt's style engine renders it as a solid filled box
       instead of a triangle, so an actual icon asset is used instead.
       %CHEVRON_ICON% resolves to a theme-specific filename in theme.py
       (rather than a literal chevron_down_<theme>.svg here) so this rule stays
       byte-identical between fluent_dark.qss/fluent_light.qss -- required
       by test_qss_parity.py, which only masks color values, not filenames. */
    width: 12px;
    height: 8px;
    image: url(%ICONS_DIR%/%CHEVRON_ICON%);
}

QComboBox QAbstractItemView {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #3A3A3A;
    selection-color: #F5F5F5;
    outline: none;
}

QComboBox QAbstractItemView::item {
    min-height: 36px;
    padding: 8px 12px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #3A3A3A;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #404040;
    color: #F5F5F5;
}

/* ---------------------------------------------------------------------------
   QTableWidget / QTableView
   --------------------------------------------------------------------------- */

QTableWidget,
QTableView {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 8px;
    gridline-color: #333333;
    selection-background-color: rgba(0, 180, 216, 0.1);
    selection-color: #F5F5F5;
    alternate-background-color: #333333;
}

QTableWidget::item,
QTableView::item {
    padding: 8px;
    min-height: 44px;
    border-left: 3px solid transparent;
}

/* Tint + left-border accent, matching the selectableList list-item
   selection language used elsewhere in the app. */
QTableWidget::item:selected,
QTableView::item:selected {
    background-color: rgba(0, 180, 216, 0.1);
    color: #F5F5F5;
    border-left: 3px solid #00B4D8;
}

QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #3A3A3A;
}

/* ---------------------------------------------------------------------------
   QHeaderView
   --------------------------------------------------------------------------- */

QHeaderView {
    background-color: #2D2D2D;
    border: none;
}

QHeaderView::section {
    background-color: #2D2D2D;
    color: #B0B0B0;
    border: none;
    border-bottom: 1px solid #404040;
    padding: 8px;
    font-weight: 600;
    font-size: 12px;
    text-transform: uppercase;
}

QHeaderView::section:hover {
    background-color: #3A3A3A;
    color: #F5F5F5;
}

/* ---------------------------------------------------------------------------
   QScrollArea
   --------------------------------------------------------------------------- */

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ---------------------------------------------------------------------------
   QScrollBar (Vertical)
   --------------------------------------------------------------------------- */

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #404040;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #B0B0B0;
}

QScrollBar::handle:vertical:pressed {
    background-color: #00B4D8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}

/* ---------------------------------------------------------------------------
   QScrollBar (Horizontal)
   --------------------------------------------------------------------------- */

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #404040;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #B0B0B0;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #00B4D8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

/* ---------------------------------------------------------------------------
   QTabWidget / QTabBar
   --------------------------------------------------------------------------- */

QTabWidget {
    border: none;
}

QTabWidget::pane {
    background-color: #2D2D2D;
    border: 1px solid #404040;
    border-radius: 8px;
    border-top-left-radius: 0px;
    padding: 8px;
}

QTabBar {
    background-color: transparent;
    border: none;
}

QTabBar::tab {
    background-color: transparent;
    color: #B0B0B0;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    min-width: 60px;
}

QTabBar::tab:hover {
    color: #F5F5F5;
    background-color: #3A3A3A;
    border-radius: 4px 4px 0px 0px;
}

QTabBar::tab:selected {
    color: #00B4D8;
    border-bottom: 2px solid #00B4D8;
}

QTabBar::tab:disabled {
    color: #6E6E6E;
}

/* ---------------------------------------------------------------------------
   QCheckBox
   --------------------------------------------------------------------------- */

QCheckBox {
    color: #F5F5F5;
    spacing: 8px;
}

QCheckBox:disabled {
    color: #6E6E6E;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #404040;
    border-radius: 4px;
    background-color: #2D2D2D;
}

QCheckBox::indicator:hover {
    border-color: #33C5E1;
}

QCheckBox::indicator:checked {
    background-color: #00B4D8;
    border-color: #00B4D8;
}

QCheckBox::indicator:checked:hover {
    background-color: #33C5E1;
    border-color: #33C5E1;
}

QCheckBox::indicator:checked:pressed {
    background-color: #66D6EA;
    border-color: #66D6EA;
}

QCheckBox::indicator:disabled {
    background-color: #333333;
    border-color: #333333;
}

/* ---------------------------------------------------------------------------
   QRadioButton
   --------------------------------------------------------------------------- */

QRadioButton {
    color: #F5F5F5;
    spacing: 8px;
}

QRadioButton:disabled {
    color: #6E6E6E;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #404040;
    border-radius: 9px;
    background-color: #2D2D2D;
}

QRadioButton::indicator:hover {
    border-color: #33C5E1;
}

QRadioButton::indicator:checked {
    background-color: #00B4D8;
    border-color: #00B4D8;
}

QRadioButton::indicator:checked:hover {
    background-color: #33C5E1;
    border-color: #33C5E1;
}

QRadioButton::indicator:checked:pressed {
    background-color: #66D6EA;
    border-color: #66D6EA;
}

QRadioButton::indicator:disabled {
    background-color: #333333;
    border-color: #333333;
}

/* ---------------------------------------------------------------------------
   QGroupBox
   --------------------------------------------------------------------------- */

QGroupBox {
    background-color: #2D2D2D;
    border: 1px solid #404040;
    border-radius: 8px;
    margin-top: 24px;
    padding: 24px 16px 16px 16px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 8px;
    color: #F5F5F5;
}

/* ---------------------------------------------------------------------------
   QProgressBar
   --------------------------------------------------------------------------- */

QProgressBar {
    background-color: #333333;
    border: none;
    border-radius: 4px;
    min-height: 6px;
    max-height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #00B4D8;
    border-radius: 4px;
}

QProgressBar[class="success"]::chunk {
    background-color: #66BB6A;
}

QProgressBar[class="error"]::chunk {
    background-color: #EF5350;
}

/* ---------------------------------------------------------------------------
   QToolTip
   --------------------------------------------------------------------------- */

QToolTip {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 8px;
    font-size: 12px;
}

/* ---------------------------------------------------------------------------
   QMenu
   --------------------------------------------------------------------------- */

QMenu {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3A3A3A;
    color: #F5F5F5;
}

QMenu::item:disabled {
    color: #6E6E6E;
}

QMenu::separator {
    height: 1px;
    background-color: #404040;
    margin: 4px 8px;
}

QMenu::icon {
    padding-left: 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 8px;
}

/* ---------------------------------------------------------------------------
   QMenuBar
   --------------------------------------------------------------------------- */

QMenuBar {
    background-color: #1E1E1E;
    color: #F5F5F5;
    border-bottom: 1px solid #333333;
    padding: 4px 8px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #3A3A3A;
    color: #F5F5F5;
}

QMenuBar::item:pressed {
    background-color: #404040;
}

/* ---------------------------------------------------------------------------
   QDockWidget
   --------------------------------------------------------------------------- */

QDockWidget {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background-color: #2D2D2D;
    color: #F5F5F5;
    padding: 8px;
    border-bottom: 1px solid #404040;
    text-align: left;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 4px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #3A3A3A;
    border-radius: 4px;
}

/* Selectable list rows — shared by Help TOC, preset lists, and picker
   dialogs. Uses the same background-tint + left-border accent language as
   the sidebar nav's active item and DeviceCard/StatusBanner, so every
   "this row is selected" treatment in the app looks the same. */

QListWidget[class="selectableList"] {
    border: none;
    outline: none;
}

QListWidget[class="selectableList"]::item {
    padding: 4px 8px;
    border-left: 3px solid transparent;
}

QListWidget[class="selectableList"]::item:hover {
    background-color: #3A3A3A;
}

QListWidget[class="selectableList"]::item:selected {
    background-color: rgba(0, 180, 216, 0.1);
    color: #F5F5F5;
    border-left: 3px solid #00B4D8;
    outline: none;
}

/* ---------------------------------------------------------------------------
   HelpView
   --------------------------------------------------------------------------- */

#helpHeader {
    border-bottom: 1px solid #404040;
    padding: 8px;
}

#helpCloseButton {
    border: none;
    border-radius: 4px;
    font-size: 14px;
    background: transparent;
}

#helpCloseButton:hover {
    background: #3A3A3A;
}

#helpTocPanel {
    border-right: 1px solid #404040;
}

#helpSearchInput {
    padding: 4px 8px;
    border: 1px solid #404040;
    border-radius: 4px;
    font-size: 12px;
}

#helpSearchPrevButton,
#helpSearchNextButton {
    border: 1px solid #404040;
    border-radius: 3px;
    font-size: 10px;
    padding: 2px;
}

#helpSearchPrevButton:hover:!pressed,
#helpSearchNextButton:hover:!pressed {
    background: #3A3A3A;
}

#helpSearchPrevButton:pressed,
#helpSearchNextButton:pressed {
    background: #404040;
}

#helpSearchPrevButton:disabled,
#helpSearchNextButton:disabled {
    color: #6E6E6E;
}

#helpSearchHitLabel {
    font-size: 12px;
    color: #B0B0B0;
}

#helpContentBrowser {
    border: none;
    padding: 16px;
}

/* ---------------------------------------------------------------------------
   OnboardingOverlay
   --------------------------------------------------------------------------- */

QWidget#onboarding_overlay {
    background-color: rgba(0, 0, 0, 0.55);
}

QWidget#onboarding_card {
    background-color: #2D2D2D;
    border-radius: 12px;
    padding: 32px;
}

QWidget#capability_cards_row,
QWidget#onboarding_buttons_area {
    background: transparent;
}

QLabel#onboarding_title {
    font-size: 26px;
    font-weight: 700;
    color: #F5F5F5;
    background: transparent;
}

QLabel#onboarding_subtitle {
    font-size: 14px;
    color: #B0B0B0;
    background: transparent;
}

QWidget[class="onboardingCapCard"] {
    background-color: #1E1E1E;
    border-radius: 8px;
    border: 1px solid #333333;
    padding: 16px;
}

QLabel#onboarding_cap_icon {
    font-size: 32px;
    background: transparent;
}

QLabel[class="onboardingCapTitle"] {
    font-size: 16px;
    font-weight: 600;
    color: #F5F5F5;
    background: transparent;
}

QLabel[class="onboardingCapDesc"] {
    font-size: 12px;
    color: #B0B0B0;
    background: transparent;
}

QLabel#get_started_button {
    background-color: #00B4D8;
    color: #FFFFFF;
    border-radius: 6px;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 24px;
}

/* ---------------------------------------------------------------------------
   QStatusBar
   --------------------------------------------------------------------------- */

QStatusBar {
    background-color: #1E1E1E;
    color: #B0B0B0;
    border-top: 1px solid #333333;
    padding: 4px 8px;
    font-size: 12px;
}

QStatusBar::item {
    border: none;
}

/* ---------------------------------------------------------------------------
   QSplitter
   --------------------------------------------------------------------------- */

QSplitter {
    background-color: transparent;
}

QSplitter::handle {
    background-color: #404040;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #00B4D8;
}

/* ---------------------------------------------------------------------------
   Card Containers (custom property)
   --------------------------------------------------------------------------- */

QFrame[class="card"] {
    background-color: #2D2D2D;
    border: 1px solid #404040;
    border-radius: 8px;
    padding: 16px;
}

QFrame[class="card"]:hover {
    border-color: #33C5E1;
    background-color: #3A3A3A;
}

QFrame[class="card"][selected="true"] {
    border: 2px solid #00B4D8;
}

/* ---------------------------------------------------------------------------
   StepIndicator (custom properties)
   --------------------------------------------------------------------------- */

QWidget[class="stepWidgetActive"] {
    background-color: rgba(0, 180, 216, 36);
    border-radius: 10px;
}

/* "You are here, but currently viewing a side panel" -- same shape/weight
   as the active pill so it's still clearly the current step, just in the
   muted upcoming-step palette instead of the accent color, so it can't be
   mistaken for "this is where you are right now" while a sidebar
   destination is on screen. */
QWidget[class="stepWidgetActiveDimmed"] {
    background-color: rgba(110, 110, 110, 30);
    border-radius: 10px;
}

/* "You are here, browsing" -- the page on screen when it is not the
   frontier (lazy-invalidation model). Outlined instead of filled so the
   two "you" markers can't be confused: filled accent pill = the frontier
   ("resume here"), outlined pill + checkmark = a completed step being
   viewed ("just looking"). */
QWidget[class="stepWidgetViewing"] {
    background-color: transparent;
    border: 1px solid #00B4D8;
    border-radius: 10px;
}

QWidget[class="stepWidgetViewingDimmed"] {
    background-color: transparent;
    border: 1px solid #6E6E6E;
    border-radius: 10px;
}

QLabel[class="stepCircleCompleted"] {
    background-color: #00B4D8;
    border-radius: 10px;
    color: #FFFFFF;
    font-weight: bold;
    font-size: 12px;
}

QLabel[class="stepCircleActive"] {
    background-color: transparent;
    border: 2px solid #00B4D8;
    border-radius: 10px;
    color: #00B4D8;
    font-weight: bold;
    font-size: 12px;
}

QLabel[class="stepCircleUpcoming"] {
    background-color: transparent;
    border: 2px solid #6E6E6E;
    border-radius: 10px;
    color: #6E6E6E;
}

QLabel[class="stepCircleActiveDimmed"] {
    background-color: transparent;
    border: 2px solid #6E6E6E;
    border-radius: 10px;
    color: #6E6E6E;
    font-weight: bold;
    font-size: 12px;
}

QLabel[class="stepLabelCompleted"] {
    color: #00B4D8;
}

QLabel[class="stepLabelActive"] {
    color: #00B4D8;
    font-weight: bold;
}

QLabel[class="stepLabelActiveDimmed"] {
    color: #B0B0B0;
    font-weight: bold;
}

QLabel[class="stepLabelUpcoming"] {
    color: #6E6E6E;
}

QLabel[class="stepConnector"] {
    background-color: #404040;
}

QLabel[class="stepConnectorActive"] {
    background-color: #00B4D8;
}

/* ---------------------------------------------------------------------------
   DeviceCard (custom properties)
   --------------------------------------------------------------------------- */

QFrame#DeviceCard[state="connecting"] {
    border: 2px solid #00B4D8;
}

QFrame#DeviceCard[state="connected"] {
    border-left: 3px solid #00B4D8;
}

/* ---------------------------------------------------------------------------
   SidebarNav (custom properties)
   --------------------------------------------------------------------------- */

QPushButton#SidebarNavItem[class="navItem"] {
    background-color: transparent;
    border: none;
    text-align: left;
    padding-left: 11px;
}

QPushButton#SidebarNavItem[class="navItem"]:hover {
    background-color: #3A3A3A;
}

QPushButton#SidebarNavItem[class="navItemActive"] {
    background-color: rgba(0, 180, 216, 0.1);
    border-left: 3px solid #00B4D8;
    text-align: left;
    padding-left: 8px;
    font-weight: 600;
}

QPushButton#SidebarDeviceLabel {
    text-align: left;
    font-weight: 600;
    border: none;
}

QPushButton#SidebarDeviceLabel:hover {
    text-decoration: underline;
}

QPushButton#SidebarToggleButton {
    background: transparent;
    border: none;
    font-size: 18px;
}

QPushButton#SidebarToggleButton:hover {
    background-color: #3A3A3A;
}

QPushButton#ConnectPageRescanButton {
    background: transparent;
    border: none;
    padding: 0 0 6px 0;
    min-height: 0px;
    font-size: 28px;
    text-align: center;
}

QPushButton#ConnectPageRescanButton:hover {
    background-color: #3A3A3A;
}

/* ---------------------------------------------------------------------------
   Status Colors (custom properties for StatusBanner)
   --------------------------------------------------------------------------- */

QFrame[status="idle"] {
    background-color: transparent;
    border: none;
}

QFrame[status="info"] {
    background-color: #2D2D2D;
    border-left: 3px solid #00B4D8;
}

QFrame[status="success"] {
    background-color: #1B3A1B;
    border-left: 3px solid #66BB6A;
}

QFrame[status="error"] {
    background-color: #3A1B1B;
    border-left: 3px solid #EF5350;
}

QFrame[status="warning"] {
    background-color: #3A2E1B;
    border-left: 3px solid #FFA726;
}

#StatusBannerMessage {
    font-size: 14px;
    font-weight: 600;
    padding: 0px;
}

#StatusBannerClose {
    font-size: 11px;
    font-weight: 600;
    border: 1px solid #404040;
    border-radius: 4px;
    background: transparent;
    padding: 1px 8px;
}

#StatusBannerClose:hover {
    background: #3A3A3A;
}

#OperationCancelButton {
    font-size: 12px;
    font-weight: 600;
    padding: 4px 12px;
    border: 1px solid #404040;
    border-radius: 4px;
    background: transparent;
}

#OperationCancelButton:hover {
    background: #3A3A3A;
}

/* ---------------------------------------------------------------------------
   Settings & Diagnostics Dialog Polish
   --------------------------------------------------------------------------- */

#DiagnosticsDialog,
#HelpDialog {
    background-color: #1E1E1E;
}

#DiagnosticsDialog QGroupBox,
#SettingsView QGroupBox {
    background-color: #2D2D2D;
    border: 1px solid #404040;
    border-radius: 8px;
    margin-top: 20px;
    padding: 16px 12px 12px 12px;
}

#DiagnosticsDialog QGroupBox::title,
#SettingsView QGroupBox::title {
    color: #F5F5F5;
    font-weight: 600;
    font-size: 13px;
}

#DiagnosticsDialog QTextEdit {
    background-color: #1E1E1E;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 4px;
}

#DiagnosticsDialog QLineEdit {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 4px;
}

#SettingsView QLineEdit[readOnly="true"] {
    background-color: #333333;
    color: #B0B0B0;
    border: 1px solid #404040;
}

/* Prevent alternating backgrounds inside Settings groupboxes */
#SettingsView QGroupBox QWidget {
    background-color: transparent;
}

#SettingsView QGroupBox QLineEdit {
    background-color: #2D2D2D;
}

#SettingsView QGroupBox QComboBox {
    background-color: #2D2D2D;
}

#SettingsView QGroupBox QSpinBox {
    background-color: #2D2D2D;
}

/* ---------------------------------------------------------------------------
   PushPage
   --------------------------------------------------------------------------- */

QLabel#PushPageStageIcon[class="stagePending"] {
    font-size: 16px;
    color: #6E6E6E;
}

QLabel#PushPageStageText[class="stagePending"] {
    font-size: 14px;
    color: #6E6E6E;
}

QLabel#PushPageStageIcon[class="stageActive"] {
    font-size: 16px;
    color: #00B4D8;
}

QLabel#PushPageStageText[class="stageActive"] {
    font-size: 14px;
    font-weight: 600;
    color: #00B4D8;
}

QLabel#PushPageStageIcon[class="stageComplete"] {
    font-size: 16px;
    color: #66BB6A;
}

QLabel#PushPageStageText[class="stageComplete"] {
    font-size: 14px;
    color: #66BB6A;
}

QLabel#PushPageStageIcon[class="stageFailed"] {
    font-size: 16px;
    color: #EF5350;
}

QLabel#PushPageStageText[class="stageFailed"] {
    font-size: 14px;
    color: #EF5350;
}

QLabel#PushPageStatusBadge {
    border-radius: 10px;
    padding: 2px 10px;
    font-size: 11px;
    font-weight: 600;
    color: #FFFFFF;
}

QLabel#PushPageStatusBadge[class="dryRun"] {
    background-color: #00B4D8;
}

QLabel#PushPageStatusBadge[class="undo"] {
    background-color: #FFA726;
}

QLabel#PushPageResultIcon {
    font-size: 36px;
}

QLabel#PushPageResultMessage {
    font-size: 16px;
}

QFrame#PushPageResultFrame[class="success"] {
    border-left: 4px solid #66BB6A;
    border-radius: 6px;
    background-color: rgba(102, 187, 106, 0.08);
}

QFrame#PushPageResultFrame[class="error"] {
    border-left: 4px solid #EF5350;
    border-radius: 6px;
    background-color: rgba(239, 83, 80, 0.08);
}

QFrame#PushPageResultFrame[class="warning"] {
    border-left: 4px solid #FFA726;
    border-radius: 6px;
    background-color: rgba(255, 167, 38, 0.08);
}

QFrame#PushPageResultFrame[class="info"] {
    border-left: 4px solid #00B4D8;
    border-radius: 6px;
    background-color: rgba(0, 180, 216, 0.08);
}

QLabel#PushPageBackupPath {
    font-size: 12px;
    font-family: monospace;
    background-color: #3A3A3A;
    padding: 4px 8px;
    border-radius: 4px;
}

QLabel#PushPageLinkSeparator {
    color: #6E6E6E;
    font-size: 13px;
}

/* ---------------------------------------------------------------------------
   FiltersPage
   --------------------------------------------------------------------------- */

#FiltersWarningsSection {
    border: 1px solid #FFA726;
    border-radius: 6px;
    padding: 12px;
    background: #3A2E1B;
}

#FiltersErrorSection {
    border: 1px solid #EF5350;
    border-radius: 6px;
    padding: 12px;
    background: #3A1B1B;
}

