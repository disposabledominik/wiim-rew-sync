/*
 * Fluent Dark Theme — WiiM ↔ REW PEQ Sync Tool
 *
 * Color values sourced from COLORS_DARK in src/gui/constants.py.
 * Structure mirrors fluent_light.qss exactly — only color values differ.
 *
 * Color reference:
 *   accent: #00B4D8  accent_hover: #33C5E1  accent_pressed: #66D6EA
 *   background: #1E1E1E  surface: #2D2D2D  surface_hover: #3A3A3A
 *   text_primary: #F5F5F5  text_secondary: #B0B0B0  text_disabled: #6E6E6E
 *   border: #404040  border_subtle: #333333
 *   card: #2D2D2D  text_on_accent: #FFFFFF
 *   success: #66BB6A  error: #EF5350  warning: #FFA726
 */

/* ---------------------------------------------------------------------------
   Global Defaults
   --------------------------------------------------------------------------- */

* {
    font-family: "Segoe UI Variable", "Segoe UI", "SF Pro", system-ui, sans-serif;
    font-size: 13px;
    color: #F5F5F5;
    outline: none;
}

/* ---------------------------------------------------------------------------
   QMainWindow
   --------------------------------------------------------------------------- */

QMainWindow {
    background-color: #1E1E1E;
}

/* ---------------------------------------------------------------------------
   QWidget
   --------------------------------------------------------------------------- */

QWidget {
    background-color: transparent;
    color: #F5F5F5;
}

/* ---------------------------------------------------------------------------
   QFrame
   --------------------------------------------------------------------------- */

QFrame {
    background-color: transparent;
    border: none;
}

QFrame[frameShape="HLine"] {
    background-color: #404040;
    max-height: 1px;
}

QFrame[frameShape="VLine"] {
    background-color: #404040;
    max-width: 1px;
}

/* ---------------------------------------------------------------------------
   QLabel
   --------------------------------------------------------------------------- */

QLabel {
    background-color: transparent;
    color: #F5F5F5;
    padding: 0px;
}

QLabel[class="heading"] {
    font-size: 18px;
    font-weight: 600;
    color: #F5F5F5;
}

QLabel[class="caption"] {
    font-size: 11px;
    color: #B0B0B0;
}

QLabel[class="secondary"] {
    color: #B0B0B0;
}

QLabel:disabled {
    color: #6E6E6E;
}

/* ---------------------------------------------------------------------------
   QPushButton
   --------------------------------------------------------------------------- */

QPushButton {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 6px;
    padding: 8px 16px;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #3A3A3A;
    border-color: #33C5E1;
}

QPushButton:pressed {
    background-color: #404040;
    border-color: #66D6EA;
}

QPushButton:disabled {
    background-color: #2D2D2D;
    color: #6E6E6E;
    border-color: #333333;
}

QPushButton:focus {
    border: 2px solid #00B4D8;
}

/* Button variants — primary */

QPushButton[class="primary"] {
    background-color: #00B4D8;
    color: #FFFFFF;
    border: 1px solid #00B4D8;
    font-weight: 600;
}

QPushButton[class="primary"]:hover {
    background-color: #33C5E1;
    border-color: #33C5E1;
}

QPushButton[class="primary"]:pressed {
    background-color: #66D6EA;
    border-color: #66D6EA;
}

QPushButton[class="primary"]:disabled {
    background-color: #333333;
    color: #6E6E6E;
    border-color: #333333;
}

/* Button variants — secondary */

QPushButton[class="secondary"] {
    background-color: transparent;
    color: #00B4D8;
    border: 1px solid #00B4D8;
}

QPushButton[class="secondary"]:hover {
    background-color: rgba(0, 180, 216, 0.1);
    border-color: #33C5E1;
    color: #33C5E1;
}

QPushButton[class="secondary"]:pressed {
    background-color: rgba(0, 180, 216, 0.2);
    border-color: #66D6EA;
    color: #66D6EA;
}

QPushButton[class="secondary"]:disabled {
    color: #6E6E6E;
    border-color: #333333;
}

/* Button variants — ghost */

QPushButton[class="ghost"] {
    background-color: transparent;
    color: #F5F5F5;
    border: none;
}

QPushButton[class="ghost"]:hover {
    background-color: #3A3A3A;
}

QPushButton[class="ghost"]:pressed {
    background-color: #404040;
}

QPushButton[class="ghost"]:disabled {
    color: #6E6E6E;
}

/* ---------------------------------------------------------------------------
   QLineEdit
   --------------------------------------------------------------------------- */

QLineEdit {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 8px;
    selection-background-color: #00B4D8;
    selection-color: #FFFFFF;
}

QLineEdit:hover {
    border-color: #33C5E1;
}

QLineEdit:focus {
    border: 2px solid #00B4D8;
    padding: 7px;
}

QLineEdit:disabled {
    background-color: #333333;
    color: #6E6E6E;
    border-color: #333333;
}

QLineEdit[readOnly="true"] {
    background-color: #333333;
    border-color: #333333;
}

/* ---------------------------------------------------------------------------
   QComboBox
   --------------------------------------------------------------------------- */

QComboBox {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 8px 24px 8px 8px;
    min-height: 20px;
}

QComboBox:hover {
    border-color: #33C5E1;
}

QComboBox:focus {
    border: 2px solid #00B4D8;
}

QComboBox:disabled {
    background-color: #333333;
    color: #6E6E6E;
    border-color: #333333;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border: none;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #3A3A3A;
    selection-color: #F5F5F5;
    outline: none;
}

/* ---------------------------------------------------------------------------
   QTableWidget / QTableView
   --------------------------------------------------------------------------- */

QTableWidget,
QTableView {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 8px;
    gridline-color: #333333;
    selection-background-color: #3A3A3A;
    selection-color: #F5F5F5;
    alternate-background-color: #333333;
}

QTableWidget::item,
QTableView::item {
    padding: 8px;
    min-height: 44px;
    border: none;
}

QTableWidget::item:selected,
QTableView::item:selected {
    background-color: #3A3A3A;
    color: #F5F5F5;
}

QTableWidget::item:hover,
QTableView::item:hover {
    background-color: #3A3A3A;
}

/* ---------------------------------------------------------------------------
   QHeaderView
   --------------------------------------------------------------------------- */

QHeaderView {
    background-color: #2D2D2D;
    border: none;
}

QHeaderView::section {
    background-color: #2D2D2D;
    color: #B0B0B0;
    border: none;
    border-bottom: 1px solid #404040;
    padding: 8px;
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
}

QHeaderView::section:hover {
    background-color: #3A3A3A;
    color: #F5F5F5;
}

/* ---------------------------------------------------------------------------
   QScrollArea
   --------------------------------------------------------------------------- */

QScrollArea {
    background-color: transparent;
    border: none;
}

QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* ---------------------------------------------------------------------------
   QScrollBar (Vertical)
   --------------------------------------------------------------------------- */

QScrollBar:vertical {
    background-color: transparent;
    width: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #404040;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #B0B0B0;
}

QScrollBar::handle:vertical:pressed {
    background-color: #00B4D8;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background-color: transparent;
}

/* ---------------------------------------------------------------------------
   QScrollBar (Horizontal)
   --------------------------------------------------------------------------- */

QScrollBar:horizontal {
    background-color: transparent;
    height: 8px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #404040;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #B0B0B0;
}

QScrollBar::handle:horizontal:pressed {
    background-color: #00B4D8;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background-color: transparent;
}

/* ---------------------------------------------------------------------------
   QTabWidget / QTabBar
   --------------------------------------------------------------------------- */

QTabWidget {
    border: none;
}

QTabWidget::pane {
    background-color: #2D2D2D;
    border: 1px solid #404040;
    border-radius: 8px;
    border-top-left-radius: 0px;
    padding: 8px;
}

QTabBar {
    background-color: transparent;
    border: none;
}

QTabBar::tab {
    background-color: transparent;
    color: #B0B0B0;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 8px 16px;
    min-width: 60px;
}

QTabBar::tab:hover {
    color: #F5F5F5;
    background-color: #3A3A3A;
    border-radius: 4px 4px 0px 0px;
}

QTabBar::tab:selected {
    color: #00B4D8;
    border-bottom: 2px solid #00B4D8;
}

QTabBar::tab:disabled {
    color: #6E6E6E;
}

/* ---------------------------------------------------------------------------
   QCheckBox
   --------------------------------------------------------------------------- */

QCheckBox {
    color: #F5F5F5;
    spacing: 8px;
}

QCheckBox:disabled {
    color: #6E6E6E;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #404040;
    border-radius: 4px;
    background-color: #2D2D2D;
}

QCheckBox::indicator:hover {
    border-color: #33C5E1;
}

QCheckBox::indicator:checked {
    background-color: #00B4D8;
    border-color: #00B4D8;
}

QCheckBox::indicator:checked:hover {
    background-color: #33C5E1;
    border-color: #33C5E1;
}

QCheckBox::indicator:checked:pressed {
    background-color: #66D6EA;
    border-color: #66D6EA;
}

QCheckBox::indicator:disabled {
    background-color: #333333;
    border-color: #333333;
}

/* ---------------------------------------------------------------------------
   QRadioButton
   --------------------------------------------------------------------------- */

QRadioButton {
    color: #F5F5F5;
    spacing: 8px;
}

QRadioButton:disabled {
    color: #6E6E6E;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #404040;
    border-radius: 9px;
    background-color: #2D2D2D;
}

QRadioButton::indicator:hover {
    border-color: #33C5E1;
}

QRadioButton::indicator:checked {
    background-color: #00B4D8;
    border-color: #00B4D8;
}

QRadioButton::indicator:checked:hover {
    background-color: #33C5E1;
    border-color: #33C5E1;
}

QRadioButton::indicator:checked:pressed {
    background-color: #66D6EA;
    border-color: #66D6EA;
}

QRadioButton::indicator:disabled {
    background-color: #333333;
    border-color: #333333;
}

/* ---------------------------------------------------------------------------
   QGroupBox
   --------------------------------------------------------------------------- */

QGroupBox {
    background-color: #2D2D2D;
    border: 1px solid #404040;
    border-radius: 8px;
    margin-top: 24px;
    padding: 24px 16px 16px 16px;
    font-weight: 600;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 8px;
    color: #F5F5F5;
}

/* ---------------------------------------------------------------------------
   QProgressBar
   --------------------------------------------------------------------------- */

QProgressBar {
    background-color: #333333;
    border: none;
    border-radius: 4px;
    min-height: 6px;
    max-height: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #00B4D8;
    border-radius: 4px;
}

/* ---------------------------------------------------------------------------
   QToolTip
   --------------------------------------------------------------------------- */

QToolTip {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 4px;
    padding: 8px;
    font-size: 11px;
}

/* ---------------------------------------------------------------------------
   QMenu
   --------------------------------------------------------------------------- */

QMenu {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
    border-radius: 8px;
    padding: 4px;
}

QMenu::item {
    padding: 8px 24px 8px 16px;
    border-radius: 4px;
}

QMenu::item:selected {
    background-color: #3A3A3A;
    color: #F5F5F5;
}

QMenu::item:disabled {
    color: #6E6E6E;
}

QMenu::separator {
    height: 1px;
    background-color: #404040;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 16px;
    height: 16px;
    margin-left: 8px;
}

/* ---------------------------------------------------------------------------
   QMenuBar
   --------------------------------------------------------------------------- */

QMenuBar {
    background-color: #1E1E1E;
    color: #F5F5F5;
    border-bottom: 1px solid #333333;
    padding: 4px 8px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 4px 8px;
    border-radius: 4px;
}

QMenuBar::item:selected {
    background-color: #3A3A3A;
}

QMenuBar::item:pressed {
    background-color: #404040;
}

/* ---------------------------------------------------------------------------
   QDockWidget
   --------------------------------------------------------------------------- */

QDockWidget {
    background-color: #2D2D2D;
    color: #F5F5F5;
    border: 1px solid #404040;
}

QDockWidget::title {
    background-color: #2D2D2D;
    color: #F5F5F5;
    padding: 8px;
    border-bottom: 1px solid #404040;
    text-align: left;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: transparent;
    border: none;
    padding: 4px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: #3A3A3A;
    border-radius: 4px;
}

/* ---------------------------------------------------------------------------
   QStatusBar
   --------------------------------------------------------------------------- */

QStatusBar {
    background-color: #1E1E1E;
    color: #B0B0B0;
    border-top: 1px solid #333333;
    padding: 4px 8px;
    font-size: 11px;
}

QStatusBar::item {
    border: none;
}

/* ---------------------------------------------------------------------------
   QSplitter
   --------------------------------------------------------------------------- */

QSplitter {
    background-color: transparent;
}

QSplitter::handle {
    background-color: #404040;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background-color: #00B4D8;
}

/* ---------------------------------------------------------------------------
   Card Containers (custom property)
   --------------------------------------------------------------------------- */

QFrame[class="card"] {
    background-color: #2D2D2D;
    border: 1px solid #404040;
    border-radius: 8px;
    padding: 16px;
}

QFrame[class="card"]:hover {
    border-color: #33C5E1;
    background-color: #3A3A3A;
}

/* ---------------------------------------------------------------------------
   Status Colors (custom properties for StatusBanner)
   --------------------------------------------------------------------------- */

QFrame[status="info"] {
    background-color: #2D2D2D;
    border-left: 3px solid #00B4D8;
}

QFrame[status="success"] {
    background-color: #1B3A1B;
    border-left: 3px solid #66BB6A;
}

QFrame[status="error"] {
    background-color: #3A1B1B;
    border-left: 3px solid #EF5350;
}

QFrame[status="warning"] {
    background-color: #3A2E1B;
    border-left: 3px solid #FFA726;
}
