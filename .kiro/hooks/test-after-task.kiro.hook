{
  "enabled": true,
  "name": "Run Tests After Task",
  "description": "Runs the full pytest suite after each spec task is marked complete to verify nothing broke.",
  "version": "1",
  "when": {
    "type": "postTaskExecution"
  },
  "then": {
    "type": "runCommand",
    "command": "wsl bash -c \"cd /mnt/c/Users/domin/Desktop/Misc/_dev/wiim-rew-sync && python3 -m pytest --no-header -q\""
  }
}