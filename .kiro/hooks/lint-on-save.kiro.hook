{
  "enabled": true,
  "name": "Lint on Save",
  "description": "Runs ruff check on any saved Python file in src/ to catch style and lint issues immediately.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/**/*.py"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "c:\\Users\\domin\\Desktop\\Misc\\_dev\\wiim-rew-sync\\scripts\\hook_lint.bat"
  }
}
