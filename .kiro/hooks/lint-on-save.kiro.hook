{
  "enabled": true,
  "name": "Lint on Save",
  "description": "Runs ruff check on any saved Python file to catch style and lint issues immediately.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "**/*.py"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "python3 -m ruff check src/"
  }
}